      <aliases enabled="yes"/>
      <column name="[evaluation_id]" datatype="integer" role="dimension" type="nominal" caption="Evaluation Id"/>
      <column name="[example_id]" datatype="integer" role="dimension" type="nominal" caption="Example Id"/>
      <column name="[category]" datatype="string" role="dimension" type="nominal" caption="Category"/>
      <column name="[model_version]" datatype="string" role="dimension" type="nominal" caption="Model Version"/>
      <column name="[date]" datatype="date" role="dimension" type="quantitative" caption="Date"/>
      <column name="[judge_1_score]" datatype="real" role="measure" type="quantitative" caption="Judge 1 Score" default-format="n1"/>
      <column name="[judge_2_score]" datatype="real" role="measure" type="quantitative" caption="Judge 2 Score" default-format="n1"/>
      <column name="[score_difference]" datatype="real" role="measure" type="quantitative" caption="Score Difference" default-format="n1"/>
      <column name="[agreement]" datatype="real" role="measure" type="quantitative" caption="Agreement" default-format="p1"/>
      <column name="[difference_bin]" datatype="integer" role="dimension" type="ordinal" caption="Difference Bin"/>
      <column name="[difference_range]" datatype="string" role="dimension" type="nominal" caption="Difference Range"/>
      <column name="[row_count]" datatype="integer" role="measure" type="quantitative" caption="Evaluations">
        <calculation class="tableau" formula="1"/>
      </column>
    </datasource>
  </datasources>
  <shared-views>
    <shared-view name="Global Lab Filters">
      <datasources>
        <datasource caption="Synthetic judge comparisons" name="lab.judges"/>
      </datasources>
      <datasource-dependencies datasource="lab.judges">
        <column name="[model_version]" datatype="string" role="dimension" type="nominal" caption="Model Version"/>
        <column name="[category]" datatype="string" role="dimension" type="nominal" caption="Category"/>
        <column name="[date]" datatype="date" role="dimension" type="quantitative" caption="Date"/>
        <column-instance column="[model_version]" name="[none:model_version:nk]" derivation="None" pivot="key" type="nominal"/>
        <column-instance column="[category]" name="[none:category:nk]" derivation="None" pivot="key" type="nominal"/>
        <column-instance column="[date]" name="[none:date:qk]" derivation="None" pivot="key" type="quantitative"/>
      </datasource-dependencies>
      <filter column="[lab.judges].[none:model_version:nk]" filter-group="1" class="categorical">
        <groupfilter function="level-members" level="[lab.judges].[none:model_version:nk]"/>
      </filter>
      <filter column="[lab.judges].[none:category:nk]" filter-group="2" class="categorical">
        <groupfilter function="level-members" level="[lab.judges].[none:category:nk]"/>
      </filter>
      <filter column="[lab.judges].[none:date:qk]" filter-group="3" class="quantitative">
        <min>#2026-07-10#</min>
        <max>#2026-10-07#</max>
      </filter>
    </shared-view>
  </shared-views>
  <worksheets>
    <worksheet name="Agreement Rate">
      <layout-options>
        <title>
          <formatted-text>
            <run fontname="Arial" fontsize="16" fontcolor="#edf5ff">Agreement Rate</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption="Synthetic judge comparisons" name="lab.judges"/>
          </datasources>
          <datasource-dependencies datasource="lab.judges">
            <column name="[agreement]" datatype="real" role="measure" type="quantitative" caption="Agreement" default-format="p1"/>
            <column name="[model_version]" datatype="string" role="dimension" type="nominal" caption="Model Version"/>
            <column name="[category]" datatype="string" role="dimension" type="nominal" caption="Category"/>
            <column name="[date]" datatype="date" role="dimension" type="quantitative" caption="Date"/>
            <column-instance column="[agreement]" name="[avg:agreement:qk]" derivation="Avg" pivot="key" type="quantitative"/>
            <column-instance column="[model_version]" name="[none:model_version:nk]" derivation="None" pivot="key" type="nominal"/>
            <column-instance column="[category]" name="[none:category:nk]" derivation="None" pivot="key" type="nominal"/>
            <column-instance column="[date]" name="[none:date:qk]" derivation="None" pivot="key" type="quantitative"/>
          </datasource-dependencies>
          <filter column="[lab.judges].[none:model_version:nk]" filter-group="1" class="categorical">
            <groupfilter function="level-members" level="[lab.judges].[none:model_version:nk]"/>
          </filter>
          <filter column="[lab.judges].[none:category:nk]" filter-group="2" class="categorical">
            <groupfilter function="level-members" level="[lab.judges].[none:category:nk]"/>
          </filter>
          <filter column="[lab.judges].[none:date:qk]" filter-group="3" class="quantitative">
            <min>#2026-07-10#</min>
            <max>#2026-10-07#</max>
          </filter>
          <aggregation value="true"/>
        </view>
        <style>
          <style-rule element="table">
            <format attr="font-family" value="Arial"/>
            <format attr="font-size" value="11"/>
            <format attr="color" value="#edf5ff"/>
            <format attr="background-color" value="#10243d"/>
          </style-rule>
          <style-rule element="pane">
            <format attr="background-color" value="#10243d"/>
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option="selection-relaxation-allow">
            <view>
              <breakdown value="auto"/>
            </view>
            <mark class="Text"/>
            <encodings>
              <text column="[lab.judges].[avg:agreement:qk]"/>
            </encodings>
            <style>
              <style-rule element="mark">
                <format attr="color" value="#70c1ff"/>
                <format attr="mark-labels-show" value="true"/>
                <format attr="mark-labels-cull" value="true"/>
                <format attr="font-size" value="28"/>
                <format attr="size" value="0.7"/>
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows></rows>
        <cols></cols>
      </table>
      <simple-id uuid="{C8AC9CB8-C29F-5E6F-9DB8-81B341DBA97A}"/>
    </worksheet>
