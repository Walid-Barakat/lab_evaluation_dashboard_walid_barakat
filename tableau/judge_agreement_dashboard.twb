<?xml version='1.0' encoding='UTF-8'?>
<workbook xmlns:user="http://www.tableausoftware.com/xml/user" version="26.2" original-version="26.2" source-build="0.0.0 (0000.0.0.0)" source-platform="mac">
  <document-format-change-manifest>
    <ManifestByVersion/>
  </document-format-change-manifest>
  <datasources>
    <datasource caption="Synthetic judge comparisons" name="lab.judges" version="26.2" inline="true">
      <connection class="textscan" directory="../data" filename="judge_agreement_data.csv" separator="," header="yes" charset="UTF-8" locale="en_US">
        <relation name="judge_agreement_data.csv" table="[judge_agreement_data.csv]" type="table">
          <columns header="yes" separator="," locale="en_US">
            <column name="evaluation_id" datatype="integer" ordinal="0"/>
            <column name="example_id" datatype="integer" ordinal="1"/>
            <column name="category" datatype="string" ordinal="2"/>
            <column name="model_version" datatype="string" ordinal="3"/>
            <column name="date" datatype="date" ordinal="4"/>
            <column name="judge_1_score" datatype="real" ordinal="5"/>
            <column name="judge_2_score" datatype="real" ordinal="6"/>
            <column name="score_difference" datatype="real" ordinal="7"/>
            <column name="agreement" datatype="real" ordinal="8"/>
            <column name="difference_bin" datatype="integer" ordinal="9"/>
            <column name="difference_range" datatype="string" ordinal="10"/>
          </columns>
        </relation>
        <metadata-records>
          <metadata-record class="column">
            <remote-name>evaluation_id</remote-name>
            <remote-type>3</remote-type>
            <local-name>[evaluation_id]</local-name>
            <parent-name>[judge_agreement_data.csv]</parent-name>
            <remote-alias>evaluation_id</remote-alias>
            <ordinal>0</ordinal>
            <local-type>integer</local-type>
            <aggregation>Count</aggregation>
            <contains-null>false</contains-null>
          </metadata-record>
          <metadata-record class="column">
            <remote-name>example_id</remote-name>
            <remote-type>3</remote-type>
            <local-name>[example_id]</local-name>
            <parent-name>[judge_agreement_data.csv]</parent-name>
            <remote-alias>example_id</remote-alias>
            <ordinal>1</ordinal>
            <local-type>integer</local-type>
            <aggregation>Count</aggregation>
            <contains-null>false</contains-null>
          </metadata-record>
          <metadata-record class="column">
            <remote-name>category</remote-name>
            <remote-type>129</remote-type>
            <local-name>[category]</local-name>
            <parent-name>[judge_agreement_data.csv]</parent-name>
            <remote-alias>category</remote-alias>
            <ordinal>2</ordinal>
            <local-type>string</local-type>
            <aggregation>Count</aggregation>
            <contains-null>false</contains-null>
          </metadata-record>
          <metadata-record class="column">
            <remote-name>model_version</remote-name>
            <remote-type>129</remote-type>
