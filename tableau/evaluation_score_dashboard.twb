<?xml version='1.0' encoding='UTF-8'?>
<workbook xmlns:user="http://www.tableausoftware.com/xml/user" version="26.2" original-version="26.2" source-build="0.0.0 (0000.0.0.0)" source-platform="mac">
  <document-format-change-manifest>
    <ManifestByVersion/>
  </document-format-change-manifest>
  <datasources>
    <datasource caption="Synthetic model evaluations" name="lab.evaluations" version="26.2" inline="true">
      <connection class="textscan" directory="../data" filename="evaluation_data_clean.csv" separator="," header="yes" charset="UTF-8" locale="en_US">
        <relation name="evaluation_data_clean.csv" table="[evaluation_data_clean.csv]" type="table">
          <columns header="yes" separator="," locale="en_US">
            <column name="evaluation_id" datatype="integer" ordinal="0"/>
            <column name="example_id" datatype="integer" ordinal="1"/>
            <column name="category" datatype="string" ordinal="2"/>
            <column name="score" datatype="real" ordinal="3"/>
            <column name="model_version" datatype="string" ordinal="4"/>
            <column name="date" datatype="date" ordinal="5"/>
            <column name="score_bin" datatype="integer" ordinal="6"/>
            <column name="score_range" datatype="string" ordinal="7"/>
            <column name="meets_target" datatype="real" ordinal="8"/>
          </columns>
        </relation>
        <metadata-records>
          <metadata-record class="column">
            <remote-name>evaluation_id</remote-name>
            <remote-type>3</remote-type>
            <local-name>[evaluation_id]</local-name>
            <parent-name>[evaluation_data_clean.csv]</parent-name>
            <remote-alias>evaluation_id</remote-alias>
            <ordinal>0</ordinal>
            <local-type>integer</local-type>
            <aggregation>Count</aggregation>
            <contains-null>false</contains-null>
          </metadata-record>
          <metadata-record class="column">
            <remote-name>example_id</remote-name>
            <remote-type>3</remote-type>
            <local-name>[example_id]</local-name>
            <parent-name>[evaluation_data_clean.csv]</parent-name>
            <remote-alias>example_id</remote-alias>
            <ordinal>1</ordinal>
            <local-type>integer</local-type>
            <aggregation>Count</aggregation>
            <contains-null>false</contains-null>
          </metadata-record>
          <metadata-record class="column">
            <remote-name>category</remote-name>
            <remote-type>129</remote-type>
            <local-name>[category]</local-name>
            <parent-name>[evaluation_data_clean.csv]</parent-name>
            <remote-alias>category</remote-alias>
            <ordinal>2</ordinal>
            <local-type>string</local-type>
            <aggregation>Count</aggregation>
            <contains-null>false</contains-null>
          </metadata-record>
          <metadata-record class="column">
            <remote-name>score</remote-name>
            <remote-type>5</remote-type>
            <local-name>[score]</local-name>
            <parent-name>[evaluation_data_clean.csv]</parent-name>
            <remote-alias>score</remote-alias>
            <ordinal>3</ordinal>
            <local-type>real</local-type>
            <aggregation>Sum</aggregation>
            <contains-null>false</contains-null>
          </metadata-record>
          <metadata-record class="column">
            <remote-name>model_version</remote-name>
            <remote-type>129</remote-type>
            <local-name>[model_version]</local-name>
            <parent-name>[evaluation_data_clean.csv]</parent-name>
            <remote-alias>model_version</remote-alias>
            <ordinal>4</ordinal>
            <local-type>string</local-type>
            <aggregation>Count</aggregation>
            <contains-null>false</contains-null>
          </metadata-record>
          <metadata-record class="column">
            <remote-name>date</remote-name>
            <remote-type>7</remote-type>
            <local-name>[date]</local-name>
            <parent-name>[evaluation_data_clean.csv]</parent-name>
            <remote-alias>date</remote-alias>
            <ordinal>5</ordinal>
            <local-type>date</local-type>
            <aggregation>Count</aggregation>
            <contains-null>false</contains-null>
          </metadata-record>
          <metadata-record class="column">
            <remote-name>score_bin</remote-name>
            <remote-type>3</remote-type>
            <local-name>[score_bin]</local-name>
            <parent-name>[evaluation_data_clean.csv]</parent-name>
            <remote-alias>score_bin</remote-alias>
            <ordinal>6</ordinal>
            <local-type>integer</local-type>
            <aggregation>Count</aggregation>
            <contains-null>false</contains-null>
          </metadata-record>
          <metadata-record class="column">
            <remote-name>score_range</remote-name>
            <remote-type>129</remote-type>
            <local-name>[score_range]</local-name>
            <parent-name>[evaluation_data_clean.csv]</parent-name>
            <remote-alias>score_range</remote-alias>
            <ordinal>7</ordinal>
            <local-type>string</local-type>
            <aggregation>Count</aggregation>
            <contains-null>false</contains-null>
          </metadata-record>
          <metadata-record class="column">
            <remote-name>meets_target</remote-name>
            <remote-type>5</remote-type>
            <local-name>[meets_target]</local-name>
            <parent-name>[evaluation_data_clean.csv]</parent-name>
            <remote-alias>meets_target</remote-alias>
            <ordinal>8</ordinal>
            <local-type>real</local-type>
            <aggregation>Sum</aggregation>
            <contains-null>false</contains-null>
          </metadata-record>
        </metadata-records>
      </connection>
      <aliases enabled="yes"/>
      <column name="[evaluation_id]" datatype="integer" role="dimension" type="nominal" caption="Evaluation Id"/>
      <column name="[example_id]" datatype="integer" role="dimension" type="nominal" caption="Example Id"/>
      <column name="[category]" datatype="string" role="dimension" type="nominal" caption="Category"/>
      <column name="[score]" datatype="real" role="measure" type="quantitative" caption="Score" default-format="n1"/>
      <column name="[model_version]" datatype="string" role="dimension" type="nominal" caption="Model Version"/>
      <column name="[date]" datatype="date" role="dimension" type="quantitative" caption="Date"/>
      <column name="[score_bin]" datatype="integer" role="dimension" type="ordinal" caption="Score Bin"/>
      <column name="[score_range]" datatype="string" role="dimension" type="nominal" caption="Score Range"/>
      <column name="[meets_target]" datatype="real" role="measure" type="quantitative" caption="Meets Target" default-format="p1"/>
      <column name="[row_count]" datatype="integer" role="measure" type="quantitative" caption="Evaluations">
        <calculation class="tableau" formula="1"/>
      </column>
    </datasource>
  </datasources>
  <shared-views>
    <shared-view name="Global Lab Filters">
      <datasources>
        <datasource caption="Synthetic model evaluations" name="lab.evaluations"/>
      </datasources>
      <datasource-dependencies datasource="lab.evaluations">
        <column name="[model_version]" datatype="string" role="dimension" type="nominal" caption="Model Version"/>
        <column name="[category]" datatype="string" role="dimension" type="nominal" caption="Category"/>
        <column name="[date]" datatype="date" role="dimension" type="quantitative" caption="Date"/>
        <column-instance column="[model_version]" name="[none:model_version:nk]" derivation="None" pivot="key" type="nominal"/>
        <column-instance column="[category]" name="[none:category:nk]" derivation="None" pivot="key" type="nominal"/>
        <column-instance column="[date]" name="[none:date:qk]" derivation="None" pivot="key" type="quantitative"/>
      </datasource-dependencies>
      <filter column="[lab.evaluations].[none:model_version:nk]" filter-group="1" class="categorical">
        <groupfilter function="level-members" level="[lab.evaluations].[none:model_version:nk]"/>
      </filter>
      <filter column="[lab.evaluations].[none:category:nk]" filter-group="2" class="categorical">
        <groupfilter function="level-members" level="[lab.evaluations].[none:category:nk]"/>
      </filter>
      <filter column="[lab.evaluations].[none:date:qk]" filter-group="3" class="quantitative">
        <min>#2026-07-10#</min>
        <max>#2026-10-07#</max>
      </filter>
    </shared-view>
  </shared-views>
  <worksheets>
    <worksheet name="Average Quality Score">
      <layout-options>
        <title>
          <formatted-text>
            <run fontname="Arial" fontsize="16" fontcolor="#edf5ff">Average Quality Score</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption="Synthetic model evaluations" name="lab.evaluations"/>
          </datasources>
          <datasource-dependencies datasource="lab.evaluations">
            <column name="[score]" datatype="real" role="measure" type="quantitative" caption="Score" default-format="n1"/>
            <column name="[model_version]" datatype="string" role="dimension" type="nominal" caption="Model Version"/>
            <column name="[category]" datatype="string" role="dimension" type="nominal" caption="Category"/>
            <column name="[date]" datatype="date" role="dimension" type="quantitative" caption="Date"/>
            <column-instance column="[score]" name="[avg:score:qk]" derivation="Avg" pivot="key" type="quantitative"/>
            <column-instance column="[model_version]" name="[none:model_version:nk]" derivation="None" pivot="key" type="nominal"/>
            <column-instance column="[category]" name="[none:category:nk]" derivation="None" pivot="key" type="nominal"/>
            <column-instance column="[date]" name="[none:date:qk]" derivation="None" pivot="key" type="quantitative"/>
          </datasource-dependencies>
          <filter column="[lab.evaluations].[none:model_version:nk]" filter-group="1" class="categorical">
            <groupfilter function="level-members" level="[lab.evaluations].[none:model_version:nk]"/>
          </filter>
          <filter column="[lab.evaluations].[none:category:nk]" filter-group="2" class="categorical">
            <groupfilter function="level-members" level="[lab.evaluations].[none:category:nk]"/>
          </filter>
          <filter column="[lab.evaluations].[none:date:qk]" filter-group="3" class="quantitative">
            <min>#2026-07-10#</min>
            <max>#2026-10-07#</max>
          </filter>
          <aggregation value="true"/>
        </view>
        <style>
          <style-rule element="table">
            <format attr="font-family" value="Arial"/>
            <format attr="font-size" value="11"/>
            <format attr="color" value="#edf5ff"/>
            <format attr="background-color" value="#10243d"/>
          </style-rule>
          <style-rule element="pane">
            <format attr="background-color" value="#10243d"/>
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option="selection-relaxation-allow">
            <view>
              <breakdown value="auto"/>
            </view>
            <mark class="Text"/>
            <encodings>
              <text column="[lab.evaluations].[avg:score:qk]"/>
            </encodings>
            <style>
              <style-rule element="mark">
                <format attr="color" value="#70c1ff"/>
                <format attr="mark-labels-show" value="true"/>
                <format attr="mark-labels-cull" value="true"/>
                <format attr="font-size" value="28"/>
                <format attr="size" value="0.7"/>
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows></rows>
        <cols></cols>
      </table>
      <simple-id uuid="{28928D05-E3CA-5ADC-B05B-3A8F156D86C0}"/>
    </worksheet>
